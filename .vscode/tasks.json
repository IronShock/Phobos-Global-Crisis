{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build selected DLL",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "build",
        "--target",
        "${input:buildTarget}",
        "--configuration",
        "${input:buildConfiguration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Prepare pinned upstream submodule",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check upstream pins and clean state",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare pinned GC reference worktree",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "prepare-reference"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Phobos docs with Sphinx",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "docs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Phobos locale files of zh_CN",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "docs-locale"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Cleanup build folders",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Setup VS Code local configuration",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/dev.py",
        "setup-vscode"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "buildTarget",
      "type": "pickString",
      "description": "Choose the DLL source: GC working checkout, upstream Phobos, or pinned GC reference",
      "options": [
        "gc",
        "upstream",
        "reference"
      ],
      "default": "gc"
    },
    {
      "id": "buildConfiguration",
      "type": "pickString",
      "description": "MSBuild configuration (upstream DevBuild maps to Release/NIGHTLY)",
      "options": [
        "Debug",
        "DevBuild",
        "Release"
      ],
      "default": "Debug"
    }
  ]
}
