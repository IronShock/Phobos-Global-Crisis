// On Windows, launch Code from a VS 2022 Developer Command Prompt (code .).
// Or set compilerPath to the installed x86 cl.exe. Select the source configuration you build.
{
  "configurations": [
    {
      "name": "GC reference Win32",
      "includePath": [
        "${workspaceFolder}/build/gc-reference/src",
        "${workspaceFolder}/build/gc-reference/src/**",
        "${workspaceFolder}/build/gc-reference/YRpp",
        "${workspaceFolder}/build/gc-reference/YRpp/**",
        "${workspaceFolder}/build/gc-reference/lib",
        "${workspaceFolder}/build/gc-reference/lib/**"
      ],
      "defines": [
        "SYR_VER=2",
        "HAS_EXCEPTIONS=0",
        "NOMINMAX",
        "_CRT_SECURE_NO_WARNINGS",
        "_WINDLL"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x86",
      "browse": {
        "limitSymbolsToIncludedHeaders": false
      }
    },
    {
      "name": "Upstream Phobos Win32",
      "includePath": [
        "${workspaceFolder}/.deps/upstream/phobos/src",
        "${workspaceFolder}/.deps/upstream/phobos/src/**",
        "${workspaceFolder}/.deps/upstream/phobos/YRpp",
        "${workspaceFolder}/.deps/upstream/phobos/YRpp/**",
        "${workspaceFolder}/.deps/upstream/phobos/Debug/IntDir/Generated"
      ],
      "defines": [
        "SYR_VER=2",
        "HAS_EXCEPTIONS=0",
        "NOMINMAX",
        "_CRT_SECURE_NO_WARNINGS",
        "_WINDLL"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x86",
      "browse": {
        "limitSymbolsToIncludedHeaders": false
      }
    },
    {
      "name": "Legacy GC Win32",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/YRpp",
        "${workspaceFolder}/YRpp/**",
        "${workspaceFolder}/lib",
        "${workspaceFolder}/lib/**"
      ],
      "defines": [
        "SYR_VER=2",
        "HAS_EXCEPTIONS=0",
        "NOMINMAX",
        "_CRT_SECURE_NO_WARNINGS",
        "_WINDLL"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x86",
      "browse": {
        "limitSymbolsToIncludedHeaders": false
      }
    }
  ],
  "version": 4
}
