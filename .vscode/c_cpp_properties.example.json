{
  // This is a Phobos project-specific config file for VSCode official C++ extension.
  // https://marketplace.visualstudio.com/items?itemName=ms-vscode.cpptools

  // On Windows, launch Code from a VS 2022 Developer Command Prompt (code .).
  // Or replace compilerPath with your installed x86 cl.exe path.
  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/YRpp",
        "${workspaceFolder}/YRpp/**",
        "${workspaceFolder}/lib",
        "${workspaceFolder}/lib/**",
    ],
      "defines": [
        "SYR_VER=2",
        "HAS_EXCEPTIONS=0",
        "NOMINMAX",
        "_CRT_SECURE_NO_WARNINGS",
        "_WINDLL"
    ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x86",
      "browse": {
        "limitSymbolsToIncludedHeaders": false
      }
    }
  ],
  "version": 4
}
