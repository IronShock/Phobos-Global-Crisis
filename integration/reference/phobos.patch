+
+	const bool isHover = pTypeExt->AdvancedDrive_Hover.Get();
+
+	if ((isHover ? pLinked->PrimaryFacing.Desired() : pLinked->PrimaryFacing.Current()) != desDir)
+	{
+		this->Do_Turn(desDir);
+
+		if (!isHover)
+			return true;
+	}
+
+	pLinked->Mark(MarkType::Up);
+	auto moveResult = pLinked->IsCellOccupied(pNextCell, static_cast<FacingType>(pathDir), cellLevel, nullptr, true);
+	pLinked->Mark(MarkType::Down);
+
+	// Straight-line mode: never attack a blocking obstacle, and never let a stale
+	// off-path route trap the unit. On ANY block exit straight-line mode, flag the
+	// cooldown (so the mode does not immediately re-cut the same blocked line),
+	// and invalidate the stale A* path - the unit re-paths from its real position
