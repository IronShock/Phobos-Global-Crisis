+bool BuildingExt::CanOccupantsFire(BuildingClass* pThis, AbstractClass* pTarget)
+{
+	if (!pTarget)
+		return false;
+
+	if (RulesExt::Global()->UseGlobalOccupyRange && !pThis->IsCloseEnough(pTarget, 0))
+		return false;
+
+	int& firingIdx = pThis->FiringOccupantIndex;
+	const int originalFiringIdx = firingIdx;
+	const auto& occupants = pThis->Occupants;
+
+	for (firingIdx = 0; firingIdx < occupants.Count; ++firingIdx)
+	{
+		InfantryClass* const pOcc = occupants[firingIdx];
+
+		// Skip stale/freed entries: the UrbanCombat code mutates Occupants and a
+		// destroyed infantry pointer must never be dereferenced here.
+		if (!pOcc || InfantryClass::Array.FindItemIndex(pOcc) == -1 || !pOcc->IsAlive)
+			continue;
+
+		constexpr int weaponIdx = 0;
+
+		switch (pThis->TechnoClass::GetFireError(pTarget, weaponIdx, !RulesExt::Global()->UseGlobalOccupyRange))
+		{
+		case FireError::ILLEGAL:
+		case FireError::CANT:
+		case FireError::RANGE:
+			continue;
+
+		default:
+			break;
+		}
+
+		firingIdx = originalFiringIdx;
+		return true;
+	}
+
+	firingIdx = originalFiringIdx;
+	return false;
+}
+
+int BuildingExt::GetOccupantsRange(BuildingClass* pThis)
+{
+	if (RulesExt::Global()->UseGlobalOccupyRange)
+		return (pThis->GetOccupyRangeBonus() + RulesClass::Instance->OccupyWeaponRange) << 8;
+
+	int maximumRange = 0;
+
+	for (const auto pOccupier : pThis->Occupants)
+	{
+		if (!pOccupier || InfantryClass::Array.FindItemIndex(pOccupier) == -1 || !pOccupier->IsAlive)
+			continue;
+
+		constexpr int weaponIdx = 0;
+		auto pWeapon = pOccupier->Veterancy.IsElite()
+			? pOccupier->Type->EliteOccupyWeapon.WeaponType
+			: pOccupier->Type->OccupyWeapon.WeaponType;
+
+		if (!pWeapon)
+		{
+			pWeapon = pOccupier->GetWeapon(weaponIdx)->WeaponType;
+
+			if (!pWeapon)
+				continue;
+		}
+
+		int range = pWeapon->Range;
+
+		if (maximumRange < range)
+			maximumRange = range;
+	}
+
+	return maximumRange;
+}
+
+TechnoClass* BuildingExt::GetFiringOccupant(BuildingClass* pBuilding)
+{
+	if (!pBuilding)
+		return nullptr;
+
+	const int count = pBuilding->Occupants.Count;
+
+	if (count <= 0)
+		return nullptr;
+
+	const int index = pBuilding->FiringOccupantIndex;
+
+	if (index < 0 || index >= count)
+		return nullptr;
+
+	InfantryClass* const pOcc = pBuilding->Occupants[index];
+
+	// The entry must be a live, registered infantry; the UrbanCombat code can
+	// leave a freed pointer behind, and callers dereference the result.
+	if (!pOcc || InfantryClass::Array.FindItemIndex(pOcc) == -1 || !pOcc->IsAlive)
+		return nullptr;
+
+	return pOcc;
+}
