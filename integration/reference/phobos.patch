+
+	// Transforms tactical coordinates back to screen coordinates
+	static Point2D TacticalToScreen(const Point2D& virtualPoint);
+};
diff --git a/src/New/Entity/AttachmentClass.cpp b/src/New/Entity/AttachmentClass.cpp
