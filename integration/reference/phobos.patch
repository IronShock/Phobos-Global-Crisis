+	const FreedRecord* FindFreed(void* p)
+	{
+		if (!p)
+			return nullptr;
+
+		for (unsigned i = 0; i < FreedRingSize; ++i)
+		{
+			if (FreedRing[i].Ptr == p)
+				return &FreedRing[i];
+		}
+
+		return nullptr;
+	}
