+	{
+		void* Ptr;
+		unsigned Hash;
+		void* Ret;   // caller that performed the free
+		unsigned Gen; // generation; stale slots are ignored instead of cleared
+	};
+
+	constexpr unsigned FreedTableSize = 1u << 18;
+	FreedRec FreedTable[FreedTableSize] = {};
