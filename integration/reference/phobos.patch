+	{
+		auto& waypoints = pScenarioExt->Waypoints;
+
+		for (auto const waypoint : pExt->SpawnPoints)
+		{
+			if (waypoint >= 0
+				&& waypoints.find(waypoint) != waypoints.end()
+				&& waypoints[waypoint].X
+				&& waypoints[waypoint].Y)
+			{
