+#include <Surface.h>
+#include <Drawing.h>
+#include <GeneralDefinitions.h>
+#include <TechnoClass.h>
+#include <UnitTypeClass.h>
+#include <InfantryTypeClass.h>
+#include <FileSystem.h>
+#include <Dir.h>
+#include <Facing.h>
+#include <MissionClass.h>
+#include <FileFormats/SHP.h>
+#include <Matrix3D.h>
