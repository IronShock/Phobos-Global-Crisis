+		unsigned h = 2166136261u;
+
+		for (int i = 0; i < 40 && s[i]; ++i)
+		{
+			h ^= static_cast<unsigned char>(s[i]);
+			h *= 16777619u;
+		}
+
+		return h;
+	}
