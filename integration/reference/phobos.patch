+PipScale TechnoTypeExt::ParsePipScaleString(const char* str)
+{
+    if (!str || !str[0])
+        return PipScale::None;
+
+    if (_stricmp(str, "None") == 0)
+        return PipScale::None;
+    if (_stricmp(str, "Ammo") == 0)
+        return PipScale::Ammo;
+    if (_stricmp(str, "Tiberium") == 0)
+        return PipScale::Tiberium;
+    if (_stricmp(str, "Passengers") == 0)
+        return PipScale::Passengers;
+    if (_stricmp(str, "Power") == 0)
+        return PipScale::Power;
+    if (_stricmp(str, "MindControl") == 0)
+        return PipScale::MindControl;
+    if (_stricmp(str, "Ammo2") == 0)
+        return PipScale::Ammo2;
+
+    return PipScale::None;
+}
