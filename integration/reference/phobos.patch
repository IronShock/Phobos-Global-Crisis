+
+	CellClass* pCell = pThis->GetCell();
+	ObjectClass*& pFirst = pThis->OnBridge
+		? pCell->AltObject : pCell->FirstObject;
+
+	for (ObjectClass* pObject = pFirst; pObject; pObject = pObject->NextObject)
