+void TechnoExt::DrawMovePositionIndicator(TechnoClass* pThis, Point2D* pLocation, RectangleStruct* pBounds)
+{
+	UNREFERENCED_PARAMETER(pBounds);
+
+	// Only for non-building units (FootClass: infantry, vehicles, aircraft)
+	if (pThis->WhatAmI() == AbstractType::Building)
+		return;
+
+	// Visibility rules:
+	// - Observer: sees all units (no selection required)
+	// - Own/ally units: only shown when selected
+	// - Enemy units: only shown when MovePositionIndicator.ShowEnemy is enabled
+	const bool isObserver = HouseClass::IsCurrentPlayerObserver();
+	const bool isOwnOrAlly = pThis->Owner->IsAlliedWith(HouseClass::CurrentPlayer);
+
+	if (isObserver)
+	{
+		// Observer can see everything, no selection check needed
+	}
+	else if (isOwnOrAlly)
+	{
+		if (!pThis->IsSelected)
+			return;
+	}
+	else
+	{
+		if (!RulesExt::Global()->MovePositionIndicator_ShowEnemy)
+			return;
+	}
+
+	// Check config
+	const auto pTypeExt = TechnoExt::ExtMap.Find(pThis)->TypeExtData;
+	if (!pTypeExt->ShowMovePositionIndicator.Get(RulesExt::Global()->MovePositionIndicator))
+		return;
+
+	// Check if unit has a target
+	const auto pTarget = pThis->Target;
+	if (!pTarget)
+		return;
+
+	// Check if target is out of range (unit needs to move to attack)
+	if (pThis->IsCloseEnoughToAttack(pTarget))
+		return;
+
+	// Check if unit is in attack mission
+	if (pThis->GetCurrentMission() != Mission::Attack)
+		return;
+
+	// Get the FootClass pointer to access navigation data
+	const auto pFoot = static_cast<FootClass*>(pThis);
+
+	// Determine the actual movement destination set by the game's pathfinding.
+	// ApproachTarget searches for a reachable cell within weapon range and
+	// sets Destination to that cell, accounting for terrain and movement zones.
+	CoordStruct destCoords = CoordStruct::Empty;
+	bool hasDest = false;
+
+	// 1. Check NavQueue for the final waypoint (multi-waypoint movement)
+	if (pFoot->NavQueue.Count > 0)
+	{
+		const auto pFinalNav = pFoot->NavQueue[pFoot->NavQueue.Count - 1];
+		if (pFinalNav && pFinalNav != pTarget)
+		{
+			destCoords = pFinalNav->GetCoords();
+			hasDest = true;
+		}
+	}
+
+	// 2. If NavQueue is empty, check Destination (set by ApproachTarget)
+	if (!hasDest && pFoot->Destination && pFoot->Destination != pTarget)
+	{
+		destCoords = pFoot->Destination->GetCoords();
+		hasDest = true;
+	}
+
+	// If no actual destination is available, cannot predict the stop position
+	if (!hasDest)
+		return;
+
+	// Skip if the destination is essentially at the unit's current position
+	const CoordStruct unitCoords = pThis->GetCoords();
+	const int distSq = (destCoords.X - unitCoords.X) * (destCoords.X - unitCoords.X)
+		+ (destCoords.Y - unitCoords.Y) * (destCoords.Y - unitCoords.Y);
+	if (distSq < 256) // within ~16 leptons
+		return;
+
+	// Get color
+	const auto color = pTypeExt->MovePositionIndicatorColor.Get(RulesExt::Global()->MovePositionIndicatorColor);
+	const int colorInt = Drawing::RGB_To_Int(color);
+
+	// Convert destination to screen coordinates
+	auto destResult = TacticalClass::Instance->CoordsToClient(destCoords);
+	const Point2D destScreen = destResult.first;
+	const bool destVisible = destResult.second;
+
+	if (!destVisible)
+		return;
+
+	// Draw a dashed line from unit to the actual destination
+	Point2D lineStart = *pLocation;
+	Point2D lineEnd = destScreen;
+	DSurface::Temp->DrawDashed(&lineStart, &lineEnd, colorInt, 0);
+}
