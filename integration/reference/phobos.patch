+void TechnoExt::DrawSecondaryPips(TechnoClass* pThis, Point2D* pPosition, RectangleStruct* pBounds)
+{
+    auto const pType = pThis->GetTechnoType();
+    auto const pTypeExt = TechnoTypeExt::ExtMap.Find(pType);
+    const PipScale pipScale2 = pTypeExt->PipScale2;
+
+    if (pipScale2 == PipScale::None)
+        return;
+
+    const auto whatAmI = pThis->WhatAmI();
+    const bool isBuilding = whatAmI == AbstractType::Building;
+
+    // pPosition already points to where secondary pips should start drawing
+    // (calculated by the calling Hook). Just apply the user-defined offset.
+    // When the secondary pip scale is Ammo2, Ammo.Secondary.Offset adjusts the position.
+    Point2D offset = pipScale2 == PipScale::Ammo2
+        ? pTypeExt->Ammo_Secondary_Offset.Get()
+        : pTypeExt->PassengersPipOffset.Get();
+    Point2D position = { pPosition->X + offset.X, pPosition->Y + offset.Y };
+
+    switch (pipScale2)
+    {
+    case PipScale::Passengers:
+    {
+        if (pType->Passengers <= 0)
+            break;
+
+        const int maxPassengers = pType->Passengers;
+        const int currentPassengers = pThis->Passengers.NumPassengers;
+
+        Point2D size = isBuilding
+            ? pTypeExt->PassengersPipSize.Get(RulesExt::Global()->Pips_Generic_Buildings_Size)
+            : pTypeExt->PassengersPipSize.Get(RulesExt::Global()->Pips_Generic_Size);
+
+        // Read each passenger's Pip color from their InfantryType.
+        // If Pip= is set (e.g. Pip=Blue), use that frame index in PIPS.SHP.
+        // If Pip= is not set (PipIndex::Empty == 0), default to frame 1 (Green).
+        // Empty slots use frame 0.
+        const int defaultFrame = 3;
+        const int emptyFrame = 0;
+
+        // Draw occupied slots: iterate through actual passengers
+        int drawnCount = 0;
+        for (auto pPassenger = pThis->Passengers.GetFirstPassenger();
+            pPassenger && drawnCount < currentPassengers;
+            pPassenger = abstract_cast<FootClass*>(pPassenger->NextObject))
+        {
+            int frame = defaultFrame;
+
+            if (pPassenger->WhatAmI() == AbstractType::Infantry)
+            {
+                auto pInfantryType = static_cast<InfantryTypeClass*>(pPassenger->GetTechnoType());
+                int pipValue = static_cast<int>(pInfantryType->Pip);
+                if (pipValue > 0)
+                    frame = pipValue;
+            }
+
+            DSurface::Temp->DrawSHP(FileSystem::PALETTE_PAL, FileSystem::PIPS2_SHP,
+                frame, &position, pBounds, BlitterFlags(0x600), 0, 0,
+                ZGradient::Ground, 1000, 0, 0, 0, 0, 0);
+
+            position.X += size.X;
+            position.Y += size.Y;
+            drawnCount++;
+        }
+
+        // Draw empty slots for remaining capacity
+        for (int i = drawnCount; i < maxPassengers; i++)
+        {
+            DSurface::Temp->DrawSHP(FileSystem::PALETTE_PAL, FileSystem::PIPS2_SHP,
+                emptyFrame, &position, pBounds, BlitterFlags(0x600), 0, 0,
+                ZGradient::Ground, 1000, 0, 0, 0, 0, 0);
+
+            position.X += size.X;
+            position.Y += size.Y;
+        }
+        break;
+    }
+    case PipScale::Ammo:
+    {
+        const int maxAmmo = pType->Ammo;
+        if (maxAmmo <= 0)
+            break;
+
+        const int currentAmmo = pThis->Ammo;
+
+        Point2D size = isBuilding
+            ? pTypeExt->PassengersPipSize.Get(RulesExt::Global()->Pips_Ammo_Buildings_Size)
+            : pTypeExt->PassengersPipSize.Get(RulesExt::Global()->Pips_Ammo_Size);
+
+        // Use the type's own AmmoPipFrame / EmptyAmmoPipFrame (game built-in values)
+        const int ammoFrame = pTypeExt->AmmoPipFrame;
+        const int emptyFrame = pTypeExt->EmptyAmmoPipFrame;
+
+        for (int i = 0; i < maxAmmo; i++)
+        {
+            if (i >= currentAmmo && emptyFrame < 0)
+                break;
+
+            const int frame = i >= currentAmmo ? emptyFrame : ammoFrame;
+
+            DSurface::Temp->DrawSHP(FileSystem::PALETTE_PAL, FileSystem::PIPS2_SHP,
+                frame, &position, pBounds, BlitterFlags(0x600), 0, 0,
+                ZGradient::Ground, 1000, 0, 0, 0, 0, 0);
+
+            position.X += size.X;
+            position.Y += size.Y;
+        }
+        break;
+    }
+    // Secondary ammo pool (Ammo.Secondary)
+    case PipScale::Ammo2:
+    {
+        const int maxAmmo = pTypeExt->Ammo_Secondary.Get();
+        if (maxAmmo <= 0)
+            break;
+
+        const auto pExt = TechnoExt::ExtMap.Find(pThis);
+        const int currentAmmo = pExt->AmmoSecondary;
+
+        Point2D size = isBuilding
+            ? pTypeExt->PassengersPipSize.Get(RulesExt::Global()->Pips_Ammo_Buildings_Size)
+            : pTypeExt->PassengersPipSize.Get(RulesExt::Global()->Pips_Ammo_Size);
+
+        // Use the type's own AmmoPipFrame / EmptyAmmoPipFrame (game built-in values)
+        const int ammoFrame = pTypeExt->AmmoPipFrame;
+        const int emptyFrame = pTypeExt->EmptyAmmoPipFrame;
+
+        for (int i = 0; i < maxAmmo; i++)
+        {
+            if (i >= currentAmmo && emptyFrame < 0)
+                break;
+
+            const int frame = i >= currentAmmo ? emptyFrame : ammoFrame;
+
+            DSurface::Temp->DrawSHP(FileSystem::PALETTE_PAL, FileSystem::PIPS2_SHP,
+                frame, &position, pBounds, BlitterFlags(0x600), 0, 0,
+                ZGradient::Ground, 1000, 0, 0, 0, 0, 0);
+
+            position.X += size.X;
+            position.Y += size.Y;
+        }
+        break;
+    }
+    default:
+        break;
+    }
+}
