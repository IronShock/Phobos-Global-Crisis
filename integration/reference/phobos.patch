+		pLinked->PathWaitTimes = 10;
+		pathDir = pLinked->PathDirections[0];
+	}
+	while (false);
+
+	// True straight-line movement: when enabled and the direct line to the
+	// destination is clear, steer at the continuous angle toward the destination
+	// instead of following the cell-grid path. Falls back to the normal path
+	// whenever the line is blocked (checked per frame/cell change). After a block
