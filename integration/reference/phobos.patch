+#pragma region Data entry save/load
+
+bool TechnoTypeExt::ExtData::AttachmentDataEntry::Load(PhobosStreamReader& stm, bool registerForChange)
+{
+	return this->Serialize(stm);
+}
+
+bool TechnoTypeExt::ExtData::AttachmentDataEntry::Save(PhobosStreamWriter& stm) const
+{
+	return const_cast<AttachmentDataEntry*>(this)->Serialize(stm);
+}
+
+template <typename T>
+bool TechnoTypeExt::ExtData::AttachmentDataEntry::Serialize(T& stm)
+{
+	PhobosFixedString<32> typeName;
+	PhobosFixedString<32> technoTypeName;
+
+	// Persist the type references by NAME, not by array index. TechnoTypeClass::Array
+	// ordering/count is not guaranteed to survive a save/load (large rules + INI
+	// inheritance can reorder it), so a raw index stored in the save would resolve
+	// to the wrong TechnoType after loading. On load the names are kept in the
+	// transient Loaded*Name fields and re-resolved to indices once all types have
+	// been loaded (see ResolveAttachmentDataIndices).
+	if constexpr (std::is_same_v<T, PhobosStreamWriter>)
+	{
+		if (this->Type.Get() >= 0 && static_cast<size_t>(this->Type.Get()) < AttachmentTypeClass::Array.size())
+			typeName = AttachmentTypeClass::Array[static_cast<size_t>(this->Type.Get())]->Name;
+		if (this->TechnoType.isset() && this->TechnoType.Get() >= 0 && this->TechnoType.Get() < TechnoTypeClass::Array.Count)
+			technoTypeName = TechnoTypeClass::Array[this->TechnoType.Get()]->ID;
+	}
+
+	auto result = stm
+		.Process(typeName)
+		.Process(technoTypeName)
+		.Process(this->FLH)
+		.Process(this->IsOnTurret)
+		.Process(this->RotationAdjust)
+		.Process(this->ID)
+		.Success();
+
+	if constexpr (std::is_same_v<T, PhobosStreamReader>)
+	{
+		this->LoadedTypeName = typeName;
+		this->LoadedTechnoTypeName = technoTypeName;
+	}
+
+	return result;
+}
+
+void TechnoTypeExt::ResolveAttachmentDataIndices()
+{
+	// Container has no public iterator, so walk the game's TechnoTypeClass array
+	// and look up each type's ExtData. This runs after all type data has loaded,
+	// so TechnoTypeClass::Array is fully populated.
+	for (int i = 0; i < TechnoTypeClass::Array.Count; ++i)
+	{
+		auto const pType = TechnoTypeClass::Array[i];
+		auto const pExt = TechnoTypeExt::ExtMap.Find(pType);
+		if (!pType || !pExt)
+			continue;
+
+		for (auto& entry : pExt->AttachmentData)
+		{
+			// Resolve the AttachmentType index from the name loaded from the save.
+			if (!entry.LoadedTypeName)
+			{
+				entry.Type = ValueableIdx<AttachmentTypeClass>();
+			}
+			else
+			{
+				const int typeIdx = AttachmentTypeClass::FindIndex(entry.LoadedTypeName.data());
+				entry.Type = typeIdx >= 0
+					? ValueableIdx<AttachmentTypeClass>(typeIdx)
+					: ValueableIdx<AttachmentTypeClass>();
+			}
+
+			// Resolve the child TechnoType index from the name loaded from the save.
+			if (!entry.LoadedTechnoTypeName)
+			{
+				entry.TechnoType = NullableIdx<TechnoTypeClass>();
+			}
+			else
+			{
+				int technoTypeIdx = -1;
+				for (int j = 0; j < TechnoTypeClass::Array.Count; ++j)
+				{
+					if (_strcmpi(TechnoTypeClass::Array[j]->ID, entry.LoadedTechnoTypeName.data()) == 0)
+					{
+						technoTypeIdx = j;
+						break;
+					}
+				}
+				entry.TechnoType = technoTypeIdx >= 0
+					? NullableIdx<TechnoTypeClass>(technoTypeIdx)
+					: NullableIdx<TechnoTypeClass>();
+			}
+		}
+	}
+}
+
+#pragma endregion
