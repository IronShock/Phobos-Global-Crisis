# Detect binary files; store normalized text as LF in Git.
# Portable text checks out with LF, while C++/Windows files use CRLF below.
* text=auto eol=lf

# Repository configuration, documentation, data and portable scripts
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
.vsconfig text eol=lf
*.md text eol=lf
